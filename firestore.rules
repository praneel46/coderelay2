rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOrganizer() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'organizer' ||
        request.auth.token.get('isOrganizer', false) == true ||
        exists(/databases/$(database)/documents/organizers/$(request.auth.uid)) ||
        (request.auth.token.get('email', '') != '' &&
         exists(/databases/$(database)/documents/authorized_organizer_emails/$(request.auth.token.get('email', '').lower())) &&
         get(/databases/$(database)/documents/authorized_organizer_emails/$(request.auth.token.get('email', '').lower())).data.authorized == true)
      );
    }

    function isJudge() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'judge' ||
        (request.auth.token.get('email', '') != '' && request.auth.token.get('email', '').lower() in [
          'judge1@coderelay.com',
          'judge2@coderelay.com',
          'judge3@coderelay.com',
          'judge4@coderelay.com',
          'judge5@coderelay.com',
          'judge6@coderelay.com'
        ])
      );
    }

    function currentJudgeId() {
      return request.auth.token.get('judgeId', '') != '' ?
        request.auth.token.get('judgeId', '') :
        (request.auth.token.get('email', '').lower() == 'judge1@coderelay.com' ? 'J001' :
         request.auth.token.get('email', '').lower() == 'judge2@coderelay.com' ? 'J002' :
         request.auth.token.get('email', '').lower() == 'judge3@coderelay.com' ? 'J003' :
         request.auth.token.get('email', '').lower() == 'judge4@coderelay.com' ? 'J004' :
         request.auth.token.get('email', '').lower() == 'judge5@coderelay.com' ? 'J005' :
         request.auth.token.get('email', '').lower() == 'judge6@coderelay.com' ? 'J006' : '');
    }

    function isJudgeAssignedToTeam(teamId) {
      return isJudge() &&
        currentJudgeId() != '' &&
        exists(/databases/$(database)/documents/judges/$(currentJudgeId())) &&
        teamId in get(/databases/$(database)/documents/judges/$(currentJudgeId())).data.assignedTeamIds;
    }

    function isParticipant() {
      return isAuthenticated() && request.auth.token.get('role', '') == 'participant';
    }

    function isTeamMember(teamId) {
      return isParticipant() && request.auth.token.get('teamId', '') == teamId;
    }

    // ------------------------------------------------------------
    // Competition State (/competition/round2)
    // Server-authoritative: Participants & Judges can only read.
    // Only Organizers can modify state.
    // ------------------------------------------------------------
    match /competition/{roundId} {
      allow read: if isAuthenticated();
      allow write: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Teams Collection (/teams/{teamId})
    // Public details (names, status) readable by all authenticated users.
    // Writes restricted to Organizers.
    // ------------------------------------------------------------
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Team Credentials (/team_credentials/{teamId})
    // CRITICAL: NEVER readable or writable by participants or judges.
    // Only Cloud Functions (Admin SDK) and Organizers can access.
    // ------------------------------------------------------------
    match /team_credentials/{teamId} {
      allow read, write: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Questions Collection (/questions/{questionId})
    // Questions are readable by all authenticated participants and judges.
    // Writes restricted to Organizers.
    // ------------------------------------------------------------
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Private Answers & Solutions (/private_answers/{questionId})
    // CRITICAL: Under NO circumstances can participants read this.
    // Judges may read rubrics/solutions if authorized.
    // Organizers have full read/write access.
    // ------------------------------------------------------------
    match /private_answers/{questionId} {
      allow read: if isOrganizer() || isJudge();
      allow write: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Submissions Collection (/submissions/{submissionId})
    // - Organizers can read all submissions.
    // - Judges can read ONLY submissions belonging to teams assigned to that judge.
    // - Participants can read ONLY their own team's submissions.
    // - Submissions cannot be modified once status is 'locked'.
    // - Submissions cannot be overwritten by other teams.
    // ------------------------------------------------------------
    match /submissions/{submissionId} {
      allow read: if isOrganizer() ||
        isJudgeAssignedToTeam(resource.data.teamId) ||
        (isParticipant() && resource.data.teamId == request.auth.token.get('teamId', ''));
      
      // Participant create/update:
      allow create: if isParticipant() &&
        request.resource.data.teamId == request.auth.token.get('teamId', '') &&
        request.resource.data.get('status', '') != 'locked';

      allow update: if (
        isParticipant() &&
        request.resource.data.teamId == request.auth.token.get('teamId', '') &&
        resource.data.teamId == request.auth.token.get('teamId', '') &&
        resource.data.get('status', '') != 'locked' &&
        request.resource.data.get('status', '') != 'locked'
      ) || isOrganizer();

      allow delete: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Judges Collection (/judges/{judgeId})
    // - Organizers can read and write all judge profiles.
    // - A judge can read ONLY their own judge profile.
    // - A judge must NOT be able to read other judges' profiles.
    // ------------------------------------------------------------
    match /judges/{judgeId} {
      allow read: if isOrganizer() || (
        isJudge() && currentJudgeId() == judgeId
      );
      allow write: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Evaluations Collection (/evaluations/{evaluationId})
    // - Organizers have full read/create/update/delete access.
    // - Judges can read evaluations ONLY for their assigned teams.
    // - Judges can create/update evaluations ONLY for their assigned teams.
    // - Judges cannot evaluate an unassigned team.
    // - Judges cannot delete evaluations.
    // - Participants CANNOT read evaluations.
    // ------------------------------------------------------------
    match /evaluations/{evaluationId} {
      allow read: if isOrganizer() || (
        isJudge() &&
        isJudgeAssignedToTeam(resource.data.teamId) &&
        resource.data.judgeId == currentJudgeId()
      );
      allow create: if isOrganizer() || (
        isJudge() &&
        isJudgeAssignedToTeam(request.resource.data.teamId) &&
        request.resource.data.judgeId == currentJudgeId()
      );
      allow update: if isOrganizer() || (
        isJudge() &&
        isJudgeAssignedToTeam(resource.data.teamId) &&
        isJudgeAssignedToTeam(request.resource.data.teamId) &&
        resource.data.judgeId == currentJudgeId() &&
        request.resource.data.judgeId == currentJudgeId()
      );
      allow delete: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Results & Leaderboard (/results/{teamId})
    // Leaderboard entries are readable by all authenticated users.
    // Only Organizers (or scoring engine) can write results.
    // ------------------------------------------------------------
    match /results/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Sessions Collection (/sessions/{sessionId})
    // Tracks live user heartbeats and active devices.
    // Users can write their own session. Organizers can manage all.
    // ------------------------------------------------------------
    match /sessions/{sessionId} {
      allow read: if isOrganizer() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOrganizer() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Audit Logs (/auditLogs/{logId})
    // Append-only audit records. Organizers can read.
    // Participants CANNOT access audit logs.
    // ------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isOrganizer();
      allow create: if isOrganizer() || isJudge();
      allow update, delete: if false; // Immutable audit logs
    }

    // ------------------------------------------------------------
    // Authorized Organizer Emails Whitelist (/authorized_organizer_emails/{email})
    // Read-only for authorization checks: authenticated users can only read
    // their own authorization document, which must have authorized == true.
    // ------------------------------------------------------------
    match /authorized_organizer_emails/{email} {
      allow read: if isAuthenticated() &&
        request.auth.token.get('email', '') != '' &&
        request.auth.token.get('email', '').lower() == email.lower() &&
        resource.data.authorized == true;
      allow write: if false;
    }

    // ------------------------------------------------------------
    // Trusted Organizers Registry (/organizers/{uid})
    // Read-only for authorization checks: restricted to the user's
    // own UID document or authorized organizers.
    // ------------------------------------------------------------
    match /organizers/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isOrganizer());
      allow write: if false;
    }
  }
}
