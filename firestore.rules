rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Helper Functions
    // ------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOrganizer() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'organizer' ||
        request.auth.token.get('isOrganizer', false) == true ||
        exists(/databases/$(database)/documents/organizers/$(request.auth.uid)) ||
        (request.auth.token.get('email', '') != '' &&
         (exists(/databases/$(database)/documents/authorized_organizer_emails/$(request.auth.token.get('email', '').lower())) ?
          get(/databases/$(database)/documents/authorized_organizer_emails/$(request.auth.token.get('email', '').lower())).data.get('authorized', false) == true : false))
      );
    }

    function isJudge() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'judge' ||
        request.auth.token.get('judgeId', '') != '' ||
        exists(/databases/$(database)/documents/judges/$(request.auth.uid)) ||
        (request.auth.token.get('email', '') != '' &&
         (exists(/databases/$(database)/documents/judges/$(currentJudgeId())) ||
          request.auth.token.get('email', '').lower().matches('.*judge.*@coderelay[.]com') ||
          request.auth.token.get('email', '').lower() in [
            'judge1@coderelay.com', 'judge2@coderelay.com', 'judge3@coderelay.com',
            'judge4@coderelay.com', 'judge5@coderelay.com', 'judge6@coderelay.com'
          ]))
      );
    }

    function currentJudgeId() {
      let tid = request.auth.token.get('judgeId', '');
      return tid != '' ? tid.upper() :
        (exists(/databases/$(database)/documents/judges/$(request.auth.uid)) ?
         get(/databases/$(database)/documents/judges/$(request.auth.uid)).data.get('judgeId', request.auth.uid).upper() :
         (request.auth.token.get('email', '').lower() == 'judge1@coderelay.com' ? 'J001' :
          request.auth.token.get('email', '').lower() == 'judge2@coderelay.com' ? 'J002' :
          request.auth.token.get('email', '').lower() == 'judge3@coderelay.com' ? 'J003' :
          request.auth.token.get('email', '').lower() == 'judge4@coderelay.com' ? 'J004' :
          request.auth.token.get('email', '').lower() == 'judge5@coderelay.com' ? 'J005' :
          request.auth.token.get('email', '').lower() == 'judge6@coderelay.com' ? 'J006' :
          request.auth.uid));
    }

    function isJudgeAssignedToTeam(teamId) {
      let jid = currentJudgeId();
      return isJudge() && jid != '' && (
        (exists(/databases/$(database)/documents/judges/$(jid)) &&
         (teamId in get(/databases/$(database)/documents/judges/$(jid)).data.assignedTeamIds ||
          teamId.lower() in get(/databases/$(database)/documents/judges/$(jid)).data.assignedTeamIds ||
          teamId.upper() in get(/databases/$(database)/documents/judges/$(jid)).data.assignedTeamIds)) ||
        (exists(/databases/$(database)/documents/teams/$(teamId)) &&
         get(/databases/$(database)/documents/teams/$(teamId)).data.get('assignedJudgeId', '').lower() == jid.lower()) ||
        (exists(/databases/$(database)/documents/results/$(teamId)) &&
         get(/databases/$(database)/documents/results/$(teamId)).data.get('assignedJudgeId', '').lower() == jid.lower())
      );
    }


    function isTeamMember(teamId) {
      return isAuthenticated() && (
        (request.auth.token.get('teamId', '') != '' && request.auth.token.get('teamId', '').lower() == teamId.lower()) ||
        (request.auth.token.get('email', '') != '' && request.auth.token.get('email', '').lower() == (teamId.lower() + '@coderelay.com'))
      );
    }

    function isCompetitionActiveForStrike(strikeId) {
      let comp = get(/databases/$(database)/documents/competition/round2).data;
      let durationSecs = strikeId == 'strike1' ? 300 : (strikeId == 'strike2' ? 900 : 1200);
      let networkBufferSecs = 15;
      let deadlineWithBuffer = comp.startTime + duration.value(durationSecs + networkBufferSecs, 's');
      return comp.phase == 'active' &&
        comp.currentStrikeId == strikeId &&
        comp.get('globalLock', false) == false &&
        comp.startTime != null &&
        request.time <= deadlineWithBuffer;
    }

    function isOfficialDeadlineMet(strikeId) {
      let comp = get(/databases/$(database)/documents/competition/round2).data;
      let durationSecs = strikeId == 'strike1' ? 300 : (strikeId == 'strike2' ? 900 : 1200);
      return comp.startTime != null && request.time <= comp.startTime + duration.value(durationSecs, 's');
    }

    // ------------------------------------------------------------
    // Competition State (/competition/round2)
    // Server-authoritative: Participants & Judges can only read.
    // Only Organizers can modify state.
    // ------------------------------------------------------------
    match /competition/{roundId} {
      allow read: if isAuthenticated();
      allow write: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Team-Specific Authoritative Timers (/teamTimers/{teamId})
    // Each team has an independently addressable timer and strike status.
    // Organizers have authoritative write control (create, start, restart).
    // Participants can read their team's timer, and update completion status on early submit.
    // Participants CANNOT mutate endsAt, startedAt, durationSeconds, or other teams' timers.
    // ------------------------------------------------------------
    match /teamTimers/{teamId} {
      allow read: if isAuthenticated();
      allow create, delete: if isOrganizer();
      allow update: if isOrganizer() || (
        isTeamMember(teamId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teamId', 'currentStrikeId']) &&
        (!('strike1' in request.resource.data) || ('strike1' in resource.data)) &&
        (!('strike2' in request.resource.data) || ('strike2' in resource.data)) &&
        (!('strike3' in request.resource.data) || ('strike3' in resource.data)) &&
        (
          !('strike1' in resource.data) || (
            'strike1' in request.resource.data &&
            request.resource.data.strike1.startedAt == resource.data.strike1.startedAt &&
            request.resource.data.strike1.endsAt == resource.data.strike1.endsAt &&
            request.resource.data.strike1.durationSeconds == resource.data.strike1.durationSeconds
          )
        ) &&
        (
          !('strike2' in resource.data) || (
            'strike2' in request.resource.data &&
            request.resource.data.strike2.startedAt == resource.data.strike2.startedAt &&
            request.resource.data.strike2.endsAt == resource.data.strike2.endsAt &&
            request.resource.data.strike2.durationSeconds == resource.data.strike2.durationSeconds
          )
        ) &&
        (
          !('strike3' in resource.data) || (
            'strike3' in request.resource.data &&
            request.resource.data.strike3.startedAt == resource.data.strike3.startedAt &&
            request.resource.data.strike3.endsAt == resource.data.strike3.endsAt &&
            request.resource.data.strike3.durationSeconds == resource.data.strike3.durationSeconds
          )
        )
      );
    }

    // ------------------------------------------------------------
    // Teams Collection (/teams/{teamId})
    // Public details (names, status) readable by all authenticated users.
    // Writes restricted to Organizers.
    // Participant can only advance status: READY -> ACTIVE, ACTIVE -> COMPLETED.
    // ------------------------------------------------------------
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create, delete: if isOrganizer();
      allow update: if (
        isOrganizer() && (
          !(resource.data.status in ['READY', 'ACTIVE', 'COMPLETED', 'DISQUALIFIED'] && request.resource.data.status == 'QUALIFIED_FOR_ROUND_2')
        )
      ) || (
        isTeamMember(teamId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt', 'completedAt', 'updatedAt']) &&
        (
          (resource.data.status in ['READY', 'ready'] && request.resource.data.status == 'ACTIVE') ||
          (resource.data.status in ['ACTIVE', 'active'] && request.resource.data.status == 'COMPLETED')
        )
      );
    }

    // ------------------------------------------------------------
    // Team Credentials (/team_credentials/{teamId})
    // CRITICAL: NEVER readable or writable by participants or judges.
    // ------------------------------------------------------------
    match /team_credentials/{teamId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------
    // Questions Collection (/questions/{questionId})
    // Questions are readable by all authenticated participants and judges.
    // Writes restricted to Organizers.
    // Published questions for the currently active strike are locked.
    // ------------------------------------------------------------
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow create: if isOrganizer();
      allow update, delete: if isOrganizer() && (
        !exists(/databases/$(database)/documents/competition/round2) ||
        get(/databases/$(database)/documents/competition/round2).data.phase != 'active' ||
        get(/databases/$(database)/documents/competition/round2).data.currentStrikeId != resource.data.strikeId
      );
    }

    // ------------------------------------------------------------
    // Private Answers & Solutions (/private_answers/{questionId})
    // CRITICAL: Under NO circumstances can participants read this.
    // Judges may read rubrics/solutions if authorized.
    // Organizers have full read/write access.
    // ------------------------------------------------------------
    match /private_answers/{questionId} {
      allow read: if isOrganizer() || isJudge();
      allow write: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Submissions Collection (/submissions/{submissionId})
    // - Organizers can read all submissions.
    // - Judges can read ONLY submissions belonging to teams assigned to that judge.
    // - Participants can read ONLY their own team's submissions.
    // - Submissions cannot be modified once status is 'locked'.
    // - Submissions cannot be overwritten by other teams.
    // - Authoritative server timestamp required: submittedAt == request.time.
    // - Server-enforced deadline check via isCompetitionActiveForStrike().
    // - Client cannot claim withinOfficialDeadline: true if server time exceeded official deadline.
    // ------------------------------------------------------------
    match /submissions/{submissionId} {
      allow read: if isOrganizer() ||
        isJudgeAssignedToTeam(resource.data.teamId) ||
        isTeamMember(resource.data.teamId);
      
      // Participant create:
      allow create: if isTeamMember(request.resource.data.teamId) &&
        request.resource.data.get('status', '') != 'locked' &&
        request.resource.data.submittedAt == request.time &&
        isCompetitionActiveForStrike(request.resource.data.strikeId) &&
        (
          request.resource.data.get('withinOfficialDeadline', null) == true ?
          isOfficialDeadlineMet(request.resource.data.strikeId) :
          true
        ) &&
        (
          request.resource.data.get('acceptedViaNetworkBuffer', null) == false ?
          isOfficialDeadlineMet(request.resource.data.strikeId) :
          true
        );

      // Participant update:
      allow update: if (
        isTeamMember(request.resource.data.teamId) &&
        resource.data.teamId == request.resource.data.teamId &&
        resource.data.get('status', '') != 'locked' &&
        request.resource.data.get('status', '') != 'locked' &&
        request.resource.data.submittedAt == request.time &&
        isCompetitionActiveForStrike(request.resource.data.strikeId) &&
        (
          request.resource.data.get('withinOfficialDeadline', null) == true ?
          isOfficialDeadlineMet(request.resource.data.strikeId) :
          true
        ) &&
        (
          request.resource.data.get('acceptedViaNetworkBuffer', null) == false ?
          isOfficialDeadlineMet(request.resource.data.strikeId) :
          true
        )
      ) || isOrganizer();

      allow delete: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Judges Collection (/judges/{judgeId})
    // - Organizers can read and write all judge profiles.
    // - A judge can read ONLY their own judge profile.
    // - A judge must NOT be able to read other judges' profiles.
    // ------------------------------------------------------------
    match /judges/{judgeId} {
      allow read: if isOrganizer() || (
        isJudge() && currentJudgeId() == judgeId
      );
      allow write: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Evaluations Collection (/evaluations/{evaluationId})
    // - Organizers have full read/create/update/delete access.
    // - Judges can read evaluations ONLY for their assigned teams.
    // - Judges can create/update evaluations ONLY for their assigned teams.
    // - Judges cannot evaluate an unassigned team.
    // - Judges cannot delete evaluations.
    // - Participants CANNOT read evaluations.
    // ------------------------------------------------------------
    match /evaluations/{evaluationId} {
      allow read: if isOrganizer() || (
        isJudge() &&
        isJudgeAssignedToTeam(resource.data.teamId)
      );
      allow create: if isOrganizer() || (
        isJudge() &&
        isJudgeAssignedToTeam(request.resource.data.teamId)
      );
      allow update: if isOrganizer() || (
        isJudge() &&
        isJudgeAssignedToTeam(resource.data.teamId) &&
        isJudgeAssignedToTeam(request.resource.data.teamId)
      );
      allow delete: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Results & Leaderboard (/results/{teamId})
    // Leaderboard entries are readable by all authenticated users.
    // Organizers retain full administrative correction authority.
    // Judges can ONLY write scores within assigned teams and CANNOT
    // modify timing, teamId, or reassign judges. Participants CANNOT write.
    // ------------------------------------------------------------
    match /results/{teamId} {
      allow read: if isAuthenticated();

      allow create: if isOrganizer() || (
        isJudgeAssignedToTeam(teamId) &&
        request.resource.data.teamId == teamId
      );

      allow update: if isOrganizer() || (
        isJudgeAssignedToTeam(teamId) &&
        request.resource.data.teamId == resource.data.teamId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['timing', 'teamId', 'assignedJudgeId']) &&
        (
          request.resource.data.get('predictScore', null) == null ||
          (request.resource.data.predictScore is number &&
           request.resource.data.predictScore >= 0 &&
           request.resource.data.predictScore <= 30)
        ) &&
        (
          request.resource.data.get('debugMarks', null) == null ||
          (request.resource.data.debugMarks is number &&
           request.resource.data.debugMarks >= 0 &&
           request.resource.data.debugMarks <= 60)
        ) &&
        (
          request.resource.data.get('codeMarks', null) == null ||
          (request.resource.data.codeMarks is number &&
           request.resource.data.codeMarks >= 0 &&
           request.resource.data.codeMarks <= 60)
        )
      );

      allow delete: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Sessions Collection (/sessions/{sessionId})
    // Tracks live user heartbeats and active devices.
    // Participant sessions created only by participants. Organizers manage all.
    // ------------------------------------------------------------
    match /sessions/{sessionId} {
      allow read: if isOrganizer() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.role == 'participant';
      allow update: if isOrganizer() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isOrganizer();
    }

    // ------------------------------------------------------------
    // Audit Logs (/auditLogs/{logId})
    // Append-only audit records. Organizers can read.
    // Participants CANNOT access audit logs.
    // ------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isOrganizer();
      allow create: if isOrganizer() || isJudge();
      allow update, delete: if false; // Immutable audit logs
    }

    // ------------------------------------------------------------
    // Anti-Cheat Violations (/violations/{violationId})
    // Real-time violation tracking for Fullscreen and Tab Switches.
    // Organizers can read all violations.
    // Participants can log violations for their own team.
    // Update and delete are forbidden (immutable log).
    // ------------------------------------------------------------
    match /violations/{violationId} {
      allow read: if isOrganizer();
      allow create: if isAuthenticated() && (
        isOrganizer() ||
        (isTeamMember(request.resource.data.teamId) && request.resource.data.timestamp == request.time)
      );
      // Allow team to transition auto-submit status from TRIGGERED to CONFIRMED or FAILED
      allow update: if isAuthenticated() && (
        isOrganizer() || (
          isTeamMember(resource.data.teamId) &&
          resource.data.teamId == request.resource.data.teamId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['autoSubmitStatus', 'confirmedAt', 'autoSubmitError']) &&
          resource.data.get('autoSubmitStatus', '') == 'AUTO_SUBMIT_TRIGGERED' &&
          request.resource.data.autoSubmitStatus in ['AUTO_SUBMIT_CONFIRMED', 'AUTO_SUBMIT_FAILED']
        )
      );
      allow delete: if false;
    }

    // ------------------------------------------------------------
    // Authorized Organizer Emails Whitelist (/authorized_organizer_emails/{email})
    // Read-only for authorization checks: authenticated users can only read
    // their own authorization document, which must have authorized == true.
    // ------------------------------------------------------------
    match /authorized_organizer_emails/{email} {
      allow read: if isAuthenticated() &&
        request.auth.token.get('email', '') != '' &&
        request.auth.token.get('email', '').lower() == email.lower() &&
        resource.data.authorized == true;
      allow write: if false;
    }

    // ------------------------------------------------------------
    // Trusted Organizers Registry (/organizers/{uid})
    // Read-only for authorization checks: restricted to the user's
    // own UID document or authorized organizers.
    // ------------------------------------------------------------
    match /organizers/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isOrganizer());
      allow write: if false;
    }
  }
}
