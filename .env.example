# ============================================================
# VIDYANTRA 2026 — CODE RELAY
# Environment Configuration Template
# COPY TO .env.local FOR LOCAL CONFIGURATION
# NEVER COMMIT REAL SECRETS OR SERVICE-ACCOUNT KEYS
# ============================================================

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=vidyantra-2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vidyantra-2026
VITE_FIREBASE_STORAGE_BUCKET=vidyantra-2026.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Firebase App Check (reCAPTCHA Enterprise or Debug Token)
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Data Provider Toggle: "firebase" or "mock" (default fallback)
VITE_DATA_PROVIDER=mock
